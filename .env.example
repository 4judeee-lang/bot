# ─────────────────────────────────────────────────────────────
#  Vex — environment configuration
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information → Application ID)
CLIENT_ID=

# ── Bot behaviour ───────────────────────────────────────────
# Default prefix for servers that have not set their own
DEFAULT_PREFIX=.
# Comma separated user IDs with full access to every command (bot owners)
OWNER_IDS=
# Guild ID to register slash commands to instantly while developing.
# Leave empty to register commands globally (can take up to an hour to appear).
DEV_GUILD_ID=
# Support server invite shown in /help and on the dashboard
SUPPORT_SERVER=
# Default embed colour used before a server customises it (hex)
DEFAULT_COLOR=#8b5cf6

# ── Dashboard ───────────────────────────────────────────────
# Set to false to run the bot without the web dashboard
WEB_ENABLED=true
WEB_PORT=3000
# Public URL the dashboard is reachable at (no trailing slash)
BASE_URL=http://localhost:3000
# Random long string — signs dashboard login sessions
SESSION_SECRET=change-me-to-a-long-random-string
# OAuth2 credentials (Developer Portal → OAuth2)
# Add "<BASE_URL>/auth/callback" as a redirect URI there.
CLIENT_SECRET=

# ── Optional integrations (features degrade gracefully if unset) ──
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
# https://openweathermap.org/api
WEATHER_API_KEY=

# ── Storage ─────────────────────────────────────────────────
DATABASE_PATH=./data/vex.db
