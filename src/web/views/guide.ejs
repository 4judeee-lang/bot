<%- include('partials/header') %>

<div class="wrap">
  <div class="page-head">
    <h1>Command guide</h1>
    <p>
      All <strong><%= total %></strong> commands, what each one actually does, and every argument explained.
      The default prefix is <code><%= prefix %></code> — change it with <code><%= prefix %>prefix !</code>.
      In usage lines, <code>&lt;angle brackets&gt;</code> are required and <code>[square brackets]</code> are optional.
    </p>
  </div>

  <div class="guide-layout">
    <aside class="guide-side">
      <nav>
        <% categories.forEach((category) => { %>
          <a href="#cat-<%= category.name.toLowerCase() %>"><%= category.name %> <span class="dim small">(<%= category.commands.length %>)</span></a>
        <% }) %>
        <a href="#settings-reference">Settings reference</a>
        <a href="#variables">Message variables</a>
      </nav>
    </aside>

    <div>
      <div class="search-box">
        <label class="sr-only" for="cmd-search">Search commands</label>
        <input type="search" id="cmd-search" placeholder="Search commands — try “ban”, “level” or “colour”" autocomplete="off">
      </div>

      <p class="dim small" id="search-summary" hidden></p>

      <div id="command-list">
        <% categories.forEach((category) => { %>
          <section class="cmd-group" id="cat-<%= category.name.toLowerCase() %>" data-category="<%= category.name %>">
            <h2><%= category.name %> <span class="count"><%= category.commands.length %> commands</span></h2>

            <% category.commands.forEach((command) => { %>
              <details class="cmd" data-search="<%= (command.name + ' ' + command.description + ' ' + command.aliases.join(' ')).toLowerCase().replace(/"/g, '') %>">
                <summary>
                  <span class="cmd-name"><%= prefix %><%= command.name %></span>
                  <span class="cmd-desc"><%= command.description %></span>
                </summary>

                <div class="cmd-body">
                  <% if (command.details) { %>
                    <p><%= command.details %></p>
                  <% } %>

                  <h4>Usage</h4>
                  <pre><code><%= prefix %><%= command.name %><%= command.usage ? ' ' + command.usage : '' %></code></pre>

                  <% if (command.args.length) { %>
                    <h4>Arguments</h4>
                    <table class="arg-table">
                      <thead>
                        <tr><th>Name</th><th>Required</th><th>What it is</th></tr>
                      </thead>
                      <tbody>
                        <% command.args.forEach((arg) => { %>
                          <tr>
                            <td><code><%= arg.name %></code></td>
                            <td><%= arg.required ? 'yes' : 'no' %></td>
                            <td><%= arg.description || arg.type %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  <% } %>

                  <% if (command.examples.length) { %>
                    <h4>Examples</h4>
                    <pre><code><% command.examples.forEach((example, index) => { %><%= index ? '\n' : '' %><%= prefix %><%= example %><% }) %></code></pre>
                  <% } %>

                  <% if (command.aliases.length || command.permissions.length || command.botPermissions.length || command.ownerOnly || command.serverOwnerOnly) { %>
                    <h4>Details</h4>
                    <div class="tag-row">
                      <% command.aliases.forEach((alias) => { %>
                        <span class="tag"><%= prefix %><%= alias %></span>
                      <% }) %>
                      <% command.permissions.forEach((permission) => { %>
                        <span class="tag tag-perm">you need: <%= permission.replace(/([A-Z])/g, ' $1').trim() %></span>
                      <% }) %>
                      <% command.botPermissions.forEach((permission) => { %>
                        <span class="tag">bot needs: <%= permission.replace(/([A-Z])/g, ' $1').trim() %></span>
                      <% }) %>
                      <% if (command.serverOwnerOnly) { %><span class="tag tag-owner">server owner only</span><% } %>
                      <% if (command.ownerOnly) { %><span class="tag tag-owner">bot owner only</span><% } %>
                    </div>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </section>
        <% }) %>
      </div>

      <div class="no-results" id="no-results" hidden>
        <p>Nothing matched that search.</p>
      </div>

      <section class="cmd-group" id="settings-reference">
        <h2>Settings reference</h2>
        <p class="muted">
          Change any of these on the <a href="/dashboard">dashboard</a>, or in Discord with
          <code><%= prefix %>set &lt;key&gt; &lt;value&gt;</code>.
        </p>

        <% settingsCategories.forEach((category) => { %>
          <h3 class="mt-2"><%= category.name %></h3>
          <p class="muted small"><%= category.blurb %></p>
          <div class="table-scroll mb-2">
            <table class="ref-table">
              <thead>
                <tr><th>Key</th><th>Type</th><th>What it does</th></tr>
              </thead>
              <tbody>
                <% category.settings.forEach((setting) => { %>
                  <tr>
                    <td><code><%= setting.key %></code></td>
                    <td class="dim"><%= setting.type %></td>
                    <td class="muted"><%= setting.description %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% }) %>
      </section>

      <section class="cmd-group" id="variables">
        <h2>Message variables</h2>
        <p class="muted">
          These work in welcome, leave, boost, level-up, autoresponder, ticket and sticky messages.
        </p>

        <div class="table-scroll mb-2">
          <table class="ref-table">
            <thead><tr><th>Variable</th><th>Value</th></tr></thead>
            <tbody>
              <% variables.forEach((variable) => { %>
                <tr><td><code>{<%= variable.name %>}</code></td><td class="muted"><%= variable.description %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <h3>Embed scripts</h3>
        <p class="muted">Start a message with <code>{embed}</code> and separate the parts with <code>$v</code>:</p>
        <pre><code>{embed}{color: #8b5cf6}$v{title: Welcome!}$v{description: Hi {user.mention}}$v{thumbnail: {user.avatar}}</code></pre>
        <p class="muted">
          Parts: <code>content</code> <code>color</code> <code>title</code> <code>url</code> <code>description</code>
          <code>thumbnail</code> <code>image</code> <code>author</code> <code>footer</code> <code>field</code>
          <code>timestamp</code> <code>button</code>.
          <code>author</code>, <code>footer</code> and <code>field</code> take several values separated by <code>&amp;&amp;</code>.
        </p>
      </section>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
